const SHEET_NAME="Sheet1";const QUOTA=50;function sheet_(){const ss=SpreadsheetApp.getActiveSpreadsheet();if(!ss)throw new Error("Spreadsheet tidak ditemukan. Buka Apps Script dari spreadsheet tujuan.");const sh=ss.getSheetByName(SHEET_NAME);if(!sh)throw new Error('Tab "Sheet1" tidak ditemukan.');return sh}function out_(d){return ContentService.createTextOutput(JSON.stringify(d)).setMimeType(ContentService.MimeType.JSON)}function count_(sh){const r=sh.getLastRow();if(!r)return 0;const first=sh.getRange(1,1,1,Math.min(6,Math.max(1,sh.getLastColumn()))).getDisplayValues()[0].join(" ").toLowerCase();return /(waktu|email|nama)/.test(first)?Math.max(0,r-1):r}function doGet(e){try{const sh=sheet_(),d={success:true,total:count_(sh),quota:QUOTA,remaining:Math.max(0,QUOTA-count_(sh))},cb=e?.parameter?.callback;if(cb&&/^[A-Za-z_$][0-9A-Za-z_$]*$/.test(cb))return ContentService.createTextOutput(cb+"("+JSON.stringify(d)+");").setMimeType(ContentService.MimeType.JAVASCRIPT);return out_(d)}catch(err){const d={success:false,total:0,quota:QUOTA,message:String(err)},cb=e?.parameter?.callback;if(cb&&/^[A-Za-z_$][0-9A-Za-z_$]*$/.test(cb))return ContentService.createTextOutput(cb+"("+JSON.stringify(d)+");").setMimeType(ContentService.MimeType.JAVASCRIPT);return out_(d)}}function doPost(e){try{const sh=sheet_();const p=e.parameter||{},email=String(p.email||"").trim(),nama=String(p.nama||"").trim(),merk=String(p.merk||"").trim(),nopol=String(p.nopol||"").trim(),stnk=String(p.stnk||"").trim();if(!email||!nama||!merk||!nopol||!stnk)return HtmlService.createHtmlOutput("Semua data wajib diisi.");const total=count_(sh);if(total>=QUOTA)return HtmlService.createHtmlOutput("Kuota sudah penuh.");if(sh.getLastRow()===0)sh.appendRow(["Waktu","Email","Nama","Merk / Tipe","No. Polisi","Atas Nama STNK"]);const rows=sh.getLastRow();if(rows>0){const emails=sh.getRange(1,2,rows,1).getDisplayValues().flat().map(x=>String(x).trim().toLowerCase());if(emails.includes(email.toLowerCase()))return HtmlService.createHtmlOutput("Email sudah terdaftar.")}sh.appendRow([new Date(),email,nama,merk,nopol,stnk]);return HtmlService.createHtmlOutput("Pendaftaran berhasil.")}catch(err){return HtmlService.createHtmlOutput("Error: "+String(err))}}